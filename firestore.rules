// Regras do Firestore para tyr-wiki
// Cole estas regras no Firebase Console > Firestore > Regras
//
// Acesso: https://console.firebase.google.com/project/tyr-wiki/firestore/rules
//
// Estas regras permitem leitura e escrita pública (sem autenticação).
// Seguro para uma wiki de RPG entre amigos com poucos usuários.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
